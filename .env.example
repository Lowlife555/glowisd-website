# Django 密钥：生产环境务必替换为随机密钥（不要使用默认值）
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# 调试开关：生产环境填 False，本地开发可填 True
DJANGO_DEBUG=False
# 超级管理员初始密码：创建超管账号时使用（示例，请替换为强密码）
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
# 超级管理员邮箱（示例，请替换为真实邮箱）
DJANGO_SUPERUSER_EMAIL=admin@example.com

# —— 在线支付（Stripe 收银台）——
# 不填也能正常上线：支付页自动降级为「人工确认下单」，订单照样进后台。
# 填写后五种方式立即生效：Visa / MasterCard / 银联（银行卡表单）、支付宝、微信支付。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe 后台 → Developers → Webhooks 添加 https://glowisd.cn/pay/webhook/stripe/
# 事件勾选 checkout.session.completed，把签名密钥填到这里
STRIPE_WEBHOOK_SECRET=
# 生成客户支付回跳链接用的站点域名
SITE_BASE_URL=https://glowisd.cn
