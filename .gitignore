# env files (can opt-in for committing if needed)
.env*

# database (runtime data, not code)
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Django
db.sqlite3
/staticfiles/
__pycache__/
*.pyc

